# Local backend by default. For shared data, use your actual Render service origin.
# Shared API: https://rec-center-radar-api.onrender.com (do not append /api).
API_PROXY_TARGET=http://localhost:5000

# Public, build-time API origin for static hosting. Leave empty to use the proxy.
# GitHub Actions sets this to the shared Render API for Pages builds.
# Never put MongoDB credentials or any secret in a VITE_ variable.
VITE_API_BASE_URL=

# GitHub Actions sets /Rec-Center-Radar/ for Pages. Local development uses /.
PAGES_BASE_PATH=/
